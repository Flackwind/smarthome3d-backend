# Copy to .env and pass --env-file .env to Docker Compose.
# Origin = scheme + hostname + port, without a path or trailing slash.
SH3D_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,http://localhost:4300,http://127.0.0.1:4300,http://localhost:8080,http://127.0.0.1:8080
# Optional HA: set a URL reachable by BOTH the API container and the OAuth browser,
# e.g. http://IP_DEL_SERVER:8123 (replace IP_DEL_SERVER with your server's LAN IP).
# Empty = archive only. localhost would refer to the API container itself.
SH3D_HA_URL=
# Set true when clients use HTTPS through a reverse proxy.
SH3D_COOKIE_SECURE=false
