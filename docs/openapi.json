  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "SH3D_SESSION"
      },
      "csrfHeader": {
        "type": "apiKey",
        "in": "header",
        "name": "X-SH3D-CSRF"
      }
    },
    "schemas": {
      "Credentials": {
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 80
          },
          "password": {
            "type": "string",
            "format": "password",
            "writeOnly": true,
            "maxLength": 512
          }
        }
      },
      "Project": {
        "type": "object",
        "required": [
          "schemaVersion",
          "id",
          "name",
          "createdAt",
          "updatedAt",
          "building",
          "bindings",
          "scene"
        ],
        "properties": {
          "schemaVersion": {
            "type": "integer",
            "const": 1
          },
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,200}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "building": {
            "type": "object"
          },
          "bindings": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "scene": {
            "type": "object"
          },
          "energy": {
            "type": "object",
            "description": "Optional version-1 energy configuration without time series. Contracts, devices, whole-home meter, and gas/zones: docs/ENERGY.md and the EnergyConfig validator."
          },
          "dashboard": {
            "type": "object",
            "description": "Per-home temperature sources, optional in schema v1. Empty ID means no source; HA weather is used only with useWeatherFallback=true and a missing/unavailable outdoor sensor. Live readings are not persisted.",
            "required": [
              "indoorTemperatureEntityId",
              "outdoorTemperatureEntityId",
              "outdoorWeatherEntityId",
              "useWeatherFallback"
            ],
            "properties": {
              "indoorTemperatureEntityId": {
                "type": "string",
                "pattern": "^$|^(sensor|climate)\\.[a-z0-9_]+$"
              },
              "outdoorTemperatureEntityId": {
                "type": "string",
                "pattern": "^$|^sensor\\.[a-z0-9_]+$"
              },
              "outdoorWeatherEntityId": {
                "type": "string",
                "pattern": "^$|^weather\\.[a-z0-9_]+$"
              },
              "useWeatherFallback": {
                "type": "boolean"
              }
            }
          }
        },
        "description": "HomeProject v1 document; geometry and reference invariants are defined in API.md and the server validator."
      },
      "Document": {
        "type": "object",
        "required": [
          "project",
          "revision"
        ],
        "properties": {
          "project": {
            "$ref": "#/components/schemas/Project"
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "AssetMetadata": {
        "type": "object",
        "required": [
          "id",
          "name",
          "mediaType"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "maxLength": 200
          },
          "mediaType": {
            "type": "string"
          }
        }
      },
      "AssetInfo": {
        "allOf": [
          {
            "$ref": "#/components/schemas/AssetMetadata"
          },
          {
            "type": "object",
            "required": [
              "projectId",
              "size"
            ],
            "properties": {
              "projectId": {
                "type": "string"
              },
              "size": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        ]
      },
      "Session": {
        "type": "object",
        "required": [
          "authenticated",
          "setupRequired",
          "username",
          "csrfToken",
          "homeAssistant"
        ],
        "properties": {
          "authenticated": {
            "type": "boolean"
          },
          "setupRequired": {
            "type": "boolean"
          },
          "username": {
            "type": "string"
          },
          "csrfToken": {
            "type": "string",
            "description": "Memory only; never in backups or browser storage"
          },
          "homeAssistant": {
            "type": "object",
            "required": [
              "configured",
              "connected",
              "url",
              "message"
            ],
            "properties": {
              "configured": {
                "type": "boolean"
              },
              "connected": {
                "type": "boolean",
                "description": "Saved owner authorization can be unlocked for the configured instance; reachability is checked by the bridge"
              },
              "url": {
                "type": "string"
              },
              "message": {
                "type": "string",
                "description": "Connection problem without credentials; empty string if absent"
              }
            }
          }
        }
      },
      "EnergyTotal": {
        "type": [
          "object",
          "null"
        ],
        "properties": {
          "amount": {
            "type": "number"
          },
          "cost": {
            "type": [
              "number",
              "null"
            ]
          },
          "knownCost": {
            "type": "number"
          },
          "unpriced": {
            "type": "number"
          },
          "observedHours": {
            "type": "number"
          },
          "qualities": {
            "type": "array",
            "items": {
              "enum": [
                "sensor",
                "nominal",
                "thermal",
                "manual"
              ]
            }
          }
        },
        "description": "kWh or Smc; variable cost in EUR, null if incomplete. Observed hours; manual=0."
      },
      "EnergyMonth": {
        "type": "object",
        "properties": {
          "month": {
            "type": "string"
          },
          "electricity": {
            "$ref": "#/components/schemas/EnergyTotal"
          },
          "gas": {
            "$ref": "#/components/schemas/EnergyTotal"
          },
          "devices": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "total": {
                  "$ref": "#/components/schemas/EnergyTotal"
                }
              }
            }
          }
        }
      },
      "EnergyManual": {
        "type": "object",
        "required": [
          "month",
          "utility",
          "amount"
        ],
        "properties": {
          "month": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}$"
          },
          "utility": {
            "enum": [
              "electricity",
              "gas"
            ]
          },
          "amount": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000000000.0
          },
          "cost": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1000000000.0
          }
        }
      },
      "EnergyStatus": {
        "type": "object",
        "properties": {
          "lastSample": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "issues": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "EnergyYear": {
        "type": "object",
        "properties": {
          "months": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EnergyMonth"
            }
          },
          "monthly": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EnergyManual"
            }
          },
          "status": {
            "$ref": "#/components/schemas/EnergyStatus"
          }
        }
      }
    }
  }
}
