        "summary": "Remember the selected home in the owner profile",
        "security": [
          {
            "sessionCookie": [],
            "csrfHeader": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "projectId"
                ],
                "properties": {
                  "projectId": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_-]{1,200}$"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Selection saved"
          },
          "404": {
            "description": "Home not found"
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
